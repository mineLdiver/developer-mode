{
  "schemaVersion": 1,
  "id": "developermode",
  "version": "${version}",
  "name": "Developer Mode",
  "description": "A cheat mod for mod developers: a hold-to-open radial menu and a floating window desktop for the tools you actually need while testing.",
  "authors": [
    "mine_diver"
  ],
  "contact": {
    "homepage": "https://glass-launcher.net/",
    "sources": "https://github.com/mineLdiver/developer-mode"
  },
  "license": "MIT",
  "icon": "assets/developermode/icon.png",
  "environment": "*",
  "entrypoints": {
    "stationapi:event_bus": [
      "net.mine_diver.developermode.DeveloperMode"
    ],
    "stationapi:event_bus_client": [
      "net.mine_diver.developermode.client.DeveloperModeClient"
    ],
    "stationapi:event_bus_server": []
  },
  "mixins": [
    "developermode.mixins.json"
  ],
  "depends": {
    "minecraft": "1.0.0-beta.7.3",
    "stationapi": ">=2.0.0-alpha.6"
  }
}
